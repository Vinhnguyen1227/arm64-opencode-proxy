worker_processes auto;

events {
    worker_connections 1024;
}

http {
    include mime.types;
    default_type application/octet-stream;
    sendfile on;
    keepalive_timeout 65;

    map_hash_bucket_size 128;
    map_hash_max_size 2048;

    map $http_authorization $auth_valid {
        default 0;
        "Bearer ${USER_A_KEY}" 1;
        "Bearer ${USER_B_KEY}" 1;
    }

    map $http_authorization $auth_user {
        "Bearer ${USER_A_KEY}" "userA";
        "Bearer ${USER_B_KEY}" "userB";
        default                "unauthorized";
    }

    map $request_id $req_id_short {
        ~^(.{8}) $1;
        default  $request_id;
    }

    map $upstream_addr $log_upstream {
        ""      "local-proxy";
        default "${UPSTREAM_HOST}";
    }

    map $status $is_error {
        ~^[45]  1;
        default 0;
    }

    map $status $error_code {
        401     "PX011";
        404     "PX001";
        408     "PX008";
        413     "PX012";
        500     "PX010";
        502     "PX006";
        503     "PX003";
        504     "PX005";
        default "PX010";
    }

    map $status $error_name {
        401     "AUTH_UNAUTHORIZED";
        404     "ROUTE_NOT_FOUND";
        408     "REQUEST_READ_FAILURE";
        413     "PAYLOAD_TOO_LARGE";
        500     "PROXY_INTERNAL_ERROR";
        502     "UPSTREAM_CONNECTION_RESET";
        503     "UPSTREAM_CONNECTION_REFUSED";
        504     "UPSTREAM_RESPONSE_TIMEOUT";
        default "INTERNAL_ERROR";
    }

    map $content_type $outbound_content_type {
        default $content_type;
        ""      "application/json";
    }

    map $http_user_agent $outbound_user_agent {
        default $http_user_agent;
        ""      "opencode/1.18.21 ai-sdk/openai";
    }

    log_format opencode_access '[$time_local] INFO  [$req_id_short] $request_method $request_uri -> $log_upstream $status ${request_time}s auth=$auth_user req=${content_length}B resp=${body_bytes_sent}B';
    log_format opencode_error  '[$time_local] ERROR [$req_id_short] error_code=$error_code error=$error_name upstream=$upstream_addr auth=$auth_user client=$remote_addr duration=${request_time}s';
    log_format opencode_debug  '[$time_local] DEBUG [$req_id_short] route=$uri upstream=$upstream_addr auth=$auth_user client=$remote_addr ttfb=${upstream_header_time}s connect_time=${upstream_connect_time}s';

    access_log ${ACCESS_LOG_PATH} opencode_access;
    access_log ${ERROR_LOG_PATH}  opencode_error if=$is_error;
    access_log ${DEBUG_LOG_PATH}  opencode_debug;
    error_log  ${NGINX_SYS_LOG_PATH} warn;

    server {
        listen ${PORT};
        server_name _;
        default_type application/json;

        client_body_buffer_size 1M;
        client_max_body_size 50M;

        location = /healthz {
            return 200 '{"status":"ok","engine":"opencode-proxy","port":"${PORT}"}\n';
        }

        rewrite ^/(responses|chat/completions|models|embeddings)(.*)$ /v1/$1$2 last;

        location /v1/ {
            if ($request_method = 'OPTIONS') {
                add_header 'Access-Control-Allow-Origin' '*' always;
                add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS' always;
                add_header 'Access-Control-Allow-Headers' 'Authorization, Content-Type, Accept' always;
                add_header 'Content-Type' 'text/plain; charset=utf-8';
                add_header 'Content-Length' 0;
                return 204;
            }

            if ($auth_valid = 0) {
                return 401 '{"error":{"message":"Invalid Virtual API Key. Unauthorized proxy access.","type":"invalid_request_error","code":"invalid_api_key"}}\n';
            }

            proxy_pass ${UPSTREAM_SCHEME}://${UPSTREAM_HOST}:${UPSTREAM_PORT};

            proxy_ssl_server_name on;
            proxy_ssl_name ${UPSTREAM_HOST};
            proxy_ssl_protocols TLSv1.2 TLSv1.3;

            proxy_pass_request_body on;
            proxy_set_header Host ${UPSTREAM_HOST};
            proxy_set_header Authorization "Bearer ${MIMO_API_KEY}";
            proxy_set_header User-Agent $outbound_user_agent;
            proxy_set_header Content-Type $outbound_content_type;
            proxy_set_header Accept $http_accept;
            proxy_set_header X-Request-ID $request_id;
            add_header X-Request-ID $request_id always;
            add_header Access-Control-Allow-Origin '*' always;

            proxy_set_header X-Forwarded-For "";
            proxy_set_header X-Real-IP "";
            proxy_set_header X-Forwarded-Proto "";
            proxy_set_header X-Forwarded-Host "";

            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_buffering off;
            proxy_cache off;
            chunked_transfer_encoding on;

            proxy_connect_timeout 60s;
            proxy_send_timeout 600s;
            proxy_read_timeout 600s;
        }

        location / {
            return 404 '{"error":{"message":"Endpoint not found. OpenCode proxy routes /responses, /chat/completions, /models.","type":"invalid_request_error","code":"not_found"}}\n';
        }
    }
}
